<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>com.openminis.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>OPENMINIS</string>
	<key>get-task-allow</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.openminis.app</string>
	</array>
	<key>com.apple.private.background-task.allowed</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>proc_info-allow</key>
	<true/>
	<!-- [T-spawn-entitlements] 下面三项是「子进程能起来」的关键，缺一项就会在
	     设备上表现为 posix_spawn EPERM / dyld: Library not loaded，而日志里只
	     留下「无法启动进程」，很容易被误判成 no-sandbox 没给。
	     skip-library-validation: 允许加载/执行不是同一 team 签名的库（Theos
	     runtime 里的二进制是现场下载、现场 ldid 签的，CDHash 与主程序不同）；
	     dynamic-codesigning: 允许把可执行内存页映射进来（AOT/JIT 与现场重签
	     的二进制都需要）；library-validation 关掉后 dyld 不再按 team id 校验。 -->
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>
	<key>com.apple.private.security.storage.MobileDocuments</key>
	<true/>
</dict>
</plist>
